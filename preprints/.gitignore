# Shared by every preprint; a preprint's own .gitignore adds what is particular to it.

# drawn by make_figures.py
figures/

# LaTeX build output: each preprint's PDF, and the stamp CI injects
/*/*.pdf
/*/stamp.tex
*.aux
*.log
*.out
*.toc

# arXiv source tarball and zip, and the trees make arxiv and make arxiv-check build it in
/*/*.tar.gz
/*/*.zip
arxiv-src/
arxiv-build/
